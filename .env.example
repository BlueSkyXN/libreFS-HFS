# LibreFS HFS v2 local configuration ledger.
# Copy to .env only on a protected local machine. This file is never loaded by
# the container and is not uploaded to Hugging Face. Keep all real values out
# of Git, logs, screenshots, and generated Space bundles.

# Local deployment controls only. Do not register these as Space Settings.
HF_TOKEN=
GH_TOKEN=

# Hugging Face Space Secrets: names are registered in hfs-dev.toml.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
OPS_TOKEN=
ADMIN_TOKEN=

# Hugging Face Space Variables. Leave a value empty when the code default is
# intended; use a 40-character lowercase SHA for a release LIBREFS_COMMIT.
HFS_RELEASE_BUILD=
LIBREFS_COMMIT=
LIBREFS_REF=
GO_VERSION=
PUBLIC_BASE_URL=
MINIO_SERVER_URL=
MINIO_BROWSER_REDIRECT_URL=
ADMIN_ENABLED=
ADMIN_AUDIT_LOG=
CONTROL_PLANE_DEFAULT_LANG=
MINIO_SITE_NAME=
MINIO_SITE_REGION=
MINIO_BROWSER=
MINIO_BROWSER_REDIRECT=
MINIO_UPDATE=
MINIO_CALLHOME_ENABLE=
MINIO_API_ROOT_ACCESS=
MINIO_API_CORS_ALLOW_ORIGIN=
